{
  "name": "byjg/php-resilience",
  "description": "PHP Resilience library",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.6",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "byjg/cache-engine": "^7.0",
    "phpunit/phpunit": "^10.5|^11.5|^12.3",
    "vimeo/psalm": "^5.9|^6.2"
  },
  "suggest": {
    "byjg/cache-engine": "Provides CompareAndSwapInterface, the atomic primitive CacheEngineLockStore needs for a race-free Mutex"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\Resilience\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ByJG\\Resilience\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
