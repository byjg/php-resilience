{
  "name": "byjg/resilience",
  "description": "PHP Resilience library",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3 <8.7",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "byjg/cache-engine": "^7.0",
    "phpunit/phpunit": "^12.5",
    "psalm/phar": "^6.16"
  },
  "suggest": {
    "byjg/cache-engine": "Provides CompareAndSwapInterface, the atomic primitive CacheEngineLockStore needs for a race-free Mutex"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "psalm": "vendor/bin/psalm.phar"
  },
  "autoload": {
    "psr-4": {
      "ByJG\\Resilience\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
